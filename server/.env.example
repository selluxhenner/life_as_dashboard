# Agentic OS server — copy to .env (or /etc/agentic-os.env on the server) and fill in.
PORT=8787
HOST=127.0.0.1
PUBLIC_URL=https://agentic-os.serviweb.ch
DATA_DIR=data
HOME_TZ=Europe/Berlin
HOME_CITY=Berlin
HOME_LAT=52.52
HOME_LON=13.405

# Master token: only used to pair devices. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_TOKEN=
# 32 random bytes, base64. Encrypts stored OAuth/Slack tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENC_KEY=

# Google Cloud OAuth client (Web application). Redirect URI: https://agentic-os.serviweb.ch/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude (briefing, news, AI tracker, agent)
ANTHROPIC_API_KEY=
AI_MODEL_MAIN=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-4-5

# Voice: ElevenLabs is the natural voice (Eleven v4) and speech-to-text (Scribe) with one key.
# Pick voice and model in Settings › Voice; ELEVENLABS_VOICE_ID is only the default.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional fallback voice + transcription when ElevenLabs isn't set or fails.
OPENAI_API_KEY=

# AI leaderboard (free key from artificialanalysis.ai)
AA_API_KEY=

# Phone prototype (Twilio). Keep the Twilio balance prepaid with auto-recharge OFF.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Phone push via ntfy (install the ntfy app, subscribe to this long random topic)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# DEV=1 enables /api/dev/run-job for every device token
DEV=0
