{
  "name": "agentic-os-server",
  "version": "2.0.0",
  "private": true,
  "description": "Agentic OS backend: sync, connectors, scheduler, AI agent. Runs as one Node process on Hetzner.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch src/index.js",
    "migrate": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/migrate.js",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test test/api.test.js test/units.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.3",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "ical.js": "^2.2.1",
    "node-cron": "^4.6.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
