# Copy to .env.local (git-ignored) to build apps that connect to your server by themselves — no pairing screen.
# The token is baked into the build, so only install those builds on your own devices.
# Best: a device token made just for your builds (revocable in Settings › Devices):
#   curl -s -X POST https://agentic-os.serviweb.ch/api/devices/pair -H "Authorization: Bearer <API_TOKEN>" \
#        -H "Content-Type: application/json" -d '{"name":"My builds","platform":"build"}'
VITE_SERVER_URL=https://agentic-os.serviweb.ch
VITE_SYNC_TOKEN=
