{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agentic OS",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 22 },
        "transparent": false,
        "backgroundColor": "#05070A",
        "resizable": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": null,
    "macOS": { "minimumSystemVersion": "13.0", "entitlements": "Entitlements.plist" }
  }
}
