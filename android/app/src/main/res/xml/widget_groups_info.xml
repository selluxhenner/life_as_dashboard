<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks: two task groups side by side; resize taller for more rows. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="90dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:maxResizeWidth="600dp"
    android:maxResizeHeight="500dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_groups"
    android:previewLayout="@layout/widget_groups"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/tasks_widget_description"
    android:widgetCategory="home_screen" />
