<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks widget: two task groups side by side. The sample text is what the widget picker shows as preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/t_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="TASKS · WED 7 OCT"
            android:textColor="#FF4FE3FF"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/t_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Refresh"
            android:padding="5dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/t_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFA7B4C2"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/t_cols"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/t_left_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/t_left_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:text="● SCHOOL"
                    android:textColor="#FFE6EDF3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/t_left_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="3"
                    android:textColor="#FF6B7A8C"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/t_left_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/t_right_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/t_right_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:text="● BUSINESS"
                    android:textColor="#FFE6EDF3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/t_right_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="2"
                    android:textColor="#FF6B7A8C"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/t_right_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
