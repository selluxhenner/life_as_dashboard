<?xml version="1.0" encoding="utf-8"?>
<!-- Day-plan widget: what is on now / next with its room, then the rest of the day.
     The sample text is what the widget picker shows as preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/d_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/d_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="TODAY · WED 7 OCT"
            android:textColor="#FF4FE3FF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/d_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="2 LESSONS"
            android:textColor="#FF6B7A8C"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/d_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Refresh"
            android:padding="5dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/d_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/day_hero_lesson_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/d_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:text="NOW · UNTIL 10:45"
                    android:textColor="#FFFFC857"
                    android:textSize="10sp" />

                <Chronometer
                    android:id="@+id/d_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="#FFE6EDF3"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/d_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="Introduction to Software Engineering"
                android:textColor="#FFE6EDF3"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/d_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="09:00 – 10:45 · Practice Session · Group 2"
                android:textColor="#FFA7B4C2"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/d_room_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/day_room_bg"
            android:gravity="center"
            android:minWidth="68dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/d_room_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:text="ROOM"
                android:textColor="#B3FFC857"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/d_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="RIS"
                android:textColor="#FFFFC857"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/d_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#FFA7B4C2"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/d_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/d_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/d_row1_time" android:layout_width="48dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="11:00" android:textColor="#FFA7B4C2" android:textSize="12sp" />
            <TextView android:id="@+id/d_row1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="● STS Essentials" android:textColor="#FFE6EDF3" android:textSize="13sp" />
            <TextView android:id="@+id/d_row1_room" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="monospace" android:maxLines="1" android:text="BOX" android:textColor="#FFFFC857" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/d_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/d_row2_time" android:layout_width="48dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="13:00" android:textColor="#FFA7B4C2" android:textSize="12sp" />
            <TextView android:id="@+id/d_row2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="● Lunch with Ana" android:textColor="#FFE6EDF3" android:textSize="13sp" />
            <TextView android:id="@+id/d_row2_room" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="monospace" android:maxLines="1" android:textColor="#FFFFC857" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/d_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/d_row3_time" android:layout_width="48dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="14:00" android:textColor="#FFA7B4C2" android:textSize="12sp" />
            <TextView android:id="@+id/d_row3_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="● N26 interview" android:textColor="#FFE6EDF3" android:textSize="13sp" />
            <TextView android:id="@+id/d_row3_room" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="monospace" android:maxLines="1" android:text="ONLINE" android:textColor="#FF85ABF0" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/d_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp" android:paddingEnd="6dp" android:visibility="gone">
            <TextView android:id="@+id/d_row4_time" android:layout_width="48dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="#FFA7B4C2" android:textSize="12sp" />
            <TextView android:id="@+id/d_row4_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#FFE6EDF3" android:textSize="13sp" />
            <TextView android:id="@+id/d_row4_room" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="monospace" android:maxLines="1" android:textColor="#FFFFC857" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- pushes the tomorrow line to the bottom; on a short widget it is the first thing to go -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/d_next_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_rule_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/d_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="TOMORROW 09:00"
            android:textColor="#FF6B7A8C"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/d_next_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="STS Essentials"
            android:textColor="#FFA7B4C2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/d_next_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="BOX"
            android:textColor="#FFFFC857"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
