<?xml version="1.0" encoding="utf-8"?>
<!-- The Capture widget's popup (CaptureActivity): the home screen dimmed, the capture bar right above the keyboard. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cap_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8C05080C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/widget_bg"
        android:clickable="true"
        android:focusable="false"
        android:gravity="bottom"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_capture" />

        <EditText
            android:id="@+id/cap_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/capture_widget_hint"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
            android:maxLines="6"
            android:minHeight="44dp"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:textColor="#FFE6EDF3"
            android:textColorHint="#FF6B7A8C"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/cap_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/capture_send_bg"
            android:contentDescription="@string/capture_send"
            android:src="@drawable/ic_capture_send" />
    </LinearLayout>
</FrameLayout>
